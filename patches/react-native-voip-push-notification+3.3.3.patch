+- (void)pushRegistry:(PKPushRegistry *)registry didReceiveIncomingPushWithPayload:(PKPushPayload *)payload forType:(PKPushType)type withCompletionHandler:(void (^)(void))completion
+{
+    // Kushi: iOS 13+ requires every VoIP push to be reported to CallKit before
+    // this method returns, or it terminates the app (and after repeated misses
+    // stops delivering VoIP pushes). JS may not even be loaded yet on a cold
+    // start, so report natively here and let JS pick up the details.
+    [RNVoipPushNotificationManager didReceiveIncomingPushWithPayload:payload forType:(NSString *)type];
+
+    NSDictionary *data = payload.dictionaryPayload ?: @{};
+    NSString *intent = [data[@"intent"] isKindOfClass:[NSString class]] ? data[@"intent"] : @"";
+    NSString *callId = [data[@"callId"] isKindOfClass:[NSString class]] ? data[@"callId"] : nil;
+    NSString *caller = [data[@"caller"] isKindOfClass:[NSString class]] && [data[@"caller"] length] > 0 ? data[@"caller"] : @"Kushi call";
+    BOOL validId = callId != nil && [[NSUUID alloc] initWithUUIDString:callId] != nil;
+    BOOL isRing = [intent isEqualToString:@"voice-call"] || [intent isEqualToString:@"video-call"];
+
+    if (isRing && validId) {
+        [RNCallKeep reportNewIncomingCall:callId
+                                   handle:caller
+                               handleType:@"generic"
+                                 hasVideo:[intent isEqualToString:@"video-call"]
+                      localizedCallerName:caller
+                          supportsHolding:NO
+                             supportsDTMF:NO
+                         supportsGrouping:NO
+                       supportsUngrouping:NO
+                              fromPushKit:YES
+                                  payload:data
+                    withCompletionHandler:completion];
+        return;
+    }
+
+    // Cancel / decline (or a malformed push): end the matching call if CallKit
+    // still has it.
+    if (validId) {
+        NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:callId];
+        for (CXCall *call in [[CXCallObserver alloc] init].calls) {
+            if ([call.UUID isEqual:uuid] && !call.hasEnded) {
+                [RNCallKeep endCallWithUUID:callId reason:2];
+                if (completion) {
+                    completion();
+                }
+                return;
+            }
+        }
+    }
+
+    // Nothing to end, but iOS still requires a reported call: report a
+    // placeholder and end it at once.
+    NSString *placeholder = [[NSUUID UUID] UUIDString];
+    [RNCallKeep reportNewIncomingCall:placeholder
+                               handle:caller
+                           handleType:@"generic"
+                             hasVideo:NO
+                  localizedCallerName:caller
+                      supportsHolding:NO
+                         supportsDTMF:NO
+                     supportsGrouping:NO
+                   supportsUngrouping:NO
+                          fromPushKit:YES
+                              payload:nil
+                withCompletionHandler:^{
+        [RNCallKeep endCallWithUUID:placeholder reason:3];
+        if (completion) {
+            completion();
+        }
+    }];
+}
