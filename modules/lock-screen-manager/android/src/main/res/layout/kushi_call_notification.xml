<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming call on Android 8–11 (heads-up banner and expanded in the shade):
     who is calling, then full-width Decline and Answer buttons. 88dp tall, the
     most a heads-up banner gets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingTop="10dp"
  android:paddingEnd="16dp"
  android:paddingBottom="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/kushi_call_title"
      style="@style/TextAppearance.Compat.Notification.Title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:singleLine="true" />

    <TextView
      android:id="@+id/kushi_call_text"
      style="@style/TextAppearance.Compat.Notification.Info"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:singleLine="true" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/kushi_call_decline"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/kushi_call_decline"
      android:gravity="center"
      android:text="Decline"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/kushi_call_answer"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:background="@drawable/kushi_call_answer"
      android:gravity="center"
      android:text="Answer"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
